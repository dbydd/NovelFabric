{
  "name": "@novelfabric/backend-v2",
  "version": "0.1.0",
  "description": "NovelFabric V4 TypeScript backend CLI foundation",
  "type": "module",
  "bin": {
    "novelfabric": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check package.json tsconfig.json tsconfig.build.json eslint.config.js vitest.config.ts src/**/*.ts test/**/*.ts",
    "test": "vitest run --passWithNoTests",
    "cli": "tsx src/cli.ts"
  },
  "keywords": [
    "novelfabric",
    "workspace",
    "cli"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "commander": "^15.0.0",
    "fast-glob": "^3.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
