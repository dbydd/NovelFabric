{
  "name": "@novelfabric/v4-mono",
  "version": "0.1.0",
  "description": "NovelFabric V4 mono app CLI, optional web shell, and pi agent bridge foundation",
  "type": "module",
  "bin": {
    "novelfabric": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check package.json tsconfig.json tsconfig.build.json tsconfig.web.json eslint.config.js vite.config.ts vitest.config.ts playwright.config.ts index.html \"src/**/*.{ts,vue,css}\" \"test/**/*.ts\" \"docs/**/*.md\" \"scripts/**/*.mjs\" *.md",
    "test": "vitest run --passWithNoTests",
    "test:runtime": "vitest run --passWithNoTests test/runtime test/commands/runtime.test.ts test/cli/agent-task.test.ts",
    "test:contracts": "vitest run --passWithNoTests test/acceptance",
    "test:acceptance": "vitest run --passWithNoTests test/acceptance test/workflow test/cli/workflow.test.ts && npm run test:pi-acceptance",
    "test:pi-acceptance": "node scripts/pi-content-acceptance.mjs",
    "test:pi-sdk-acceptance": "node scripts/pi-sdk-acceptance.mjs",
    "test:e2e": "playwright test test/e2e --pass-with-no-tests",
    "cli": "tsx src/cli.ts",
    "web:dev": "vite --host 127.0.0.1 --port 50021",
    "web:build": "vue-tsc -p tsconfig.web.json --noEmit && vite build",
    "web:preview": "vite preview --host 127.0.0.1 --port 50022"
  },
  "keywords": [
    "novelfabric",
    "workspace",
    "cli"
  ],
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@earendil-works/pi-coding-agent": "^0.78.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "codemirror": "^6.0.2",
    "commander": "^15.0.0",
    "d3": "^7.9.0",
    "dompurify": "^3.4.8",
    "fast-glob": "^3.3.3",
    "marked": "^18.0.5",
    "vite": "^8.0.16",
    "vue": "^3.5.35",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^25.9.1",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8",
    "vue-tsc": "^3.3.3"
  }
}
